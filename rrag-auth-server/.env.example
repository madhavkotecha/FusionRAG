# Database
DATABASE_URL=postgresql://rrag:rrag_dev_password@localhost:5432/rrag

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=https://auth.rrag.io
JWT_AUDIENCE=https://api.rrag.io

# Server
PORT=3000
ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_UNAUTHENTICATED=20
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_API_KEY=600

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=15

# Invitations
INVITATION_EXPIRE_HOURS=72
